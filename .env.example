# ----------------------------------------------------------------------------
# TrainerCore environment variables
# Copy this file to `.env.local` and fill in real values for local development.
# On Vercel, set these in Project Settings -> Environment Variables.
#
# The app is built to BUILD and RUN with these placeholder values. Integrations
# (Stripe, Twilio) stay safely disabled until you provide real keys.
# ----------------------------------------------------------------------------

# --- Supabase (required for a working app) ---------------------------------
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable anon key (safe to expose in the browser; protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key (server only — NEVER expose to the browser). Optional:
# privileged flows fall back to SECURITY DEFINER RPCs when this is absent.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe (optional — billing activates when set) ------------------------
STRIPE_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# Stripe Price IDs for each subscription tier (create products in Stripe first)
STRIPE_PRICE_STARTER=price_starter_placeholder
STRIPE_PRICE_PRO=price_pro_placeholder
STRIPE_PRICE_STUDIO=price_studio_placeholder

# --- Twilio WhatsApp (optional — messaging activates when set) -------------
TWILIO_ACCOUNT_SID=AC_placeholder
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Sender in the form: whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- App ------------------------------------------------------------------
# Public base URL of the deployment (used for links in WhatsApp / check-ins)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret protecting /api/cron/* endpoints (generate a random string)
CRON_SECRET=change-me-to-a-long-random-string
